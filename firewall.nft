flush ruleset

table inet filter {

  chain input {
    type filter hook input priority 0; policy drop;

    iif lo accept
    ct state established,related accept

    ip protocol icmp accept

    # SSH на RTR из mgmt и client
    ip saddr { 172.16.30.128/26, 172.16.30.0/25 } tcp dport 22 accept

    # DNS к серверу
    ip daddr 172.16.30.149 udp dport 53 accept
    ip daddr 172.16.30.149 tcp dport 53 accept

    # DHCP
    udp dport {67,68} accept

    # NTP
    ip daddr 172.16.30.148 udp dport 123 accept

    # WireGuard
    udp dport 51820 accept
  }

  chain forward {
    type filter hook forward priority 0; policy drop;

    ct state established,related accept

    # интернет из внутренних сетей
    ip saddr 172.16.30.0/24 oifname "ens18" accept
    ip saddr 10.5.10.0/24 oifname "ens18" accept

    # доступ client → WEB
    ip saddr 172.16.30.0/25 ip daddr 172.16.30.201 tcp dport 5000 accept

    # DNS из внутренних сетей
    ip saddr 172.16.30.0/24 ip daddr 172.16.30.149 udp dport 53 accept
    ip saddr 172.16.30.0/24 ip daddr 172.16.30.149 tcp dport 53 accept

    # NTP
    ip saddr 172.16.30.0/24 ip daddr 172.16.30.148 udp dport 123 accept
  }

  chain output {
    type filter hook output priority 0; policy accept;
  }
}

table ip nftables_svc {

  chain POSTROUTING {
    type nat hook postrouting priority srcnat + 20;
    policy accept;

    ip saddr 172.16.30.0/25 oifname "ens18" masquerade
    ip saddr 172.16.30.128/26 oifname "ens18" masquerade
    ip saddr 172.16.30.192/28 oifname "ens18" masquerade
    ip saddr 10.5.10.0/24 oifname "ens18" masquerade
  }
}
